#!/usr/bin/python3
"""Refuse to commit or push anything that contains a secret. This repository is public.

    .githooks/check-secrets --staged          # what is about to be committed (pre-commit)
    .githooks/check-secrets --range A..B      # commits about to be pushed (pre-push)
    .githooks/check-secrets --all             # the whole history, every branch

Two checks. First, gitleaks, if installed: known token formats. Second, the values of the secrets that
actually exist on this machine (Modal, Hugging Face, GitHub, the town account, anything in ~/.secrets
or in a KEY/TOKEN/SECRET/PASSWORD environment variable): if any of those strings appears, the commit or
push stops. Values are never printed, only where they were found and which secret it was.

Turn it on in a fresh clone with:  git config core.hooksPath .githooks
"""
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
MIN = 12  # shorter strings match by accident


def known_secrets():
    found = {}

    def add(name, value):
        value = (value or "").strip().strip("\"'")
        if len(value) >= MIN:
            found[value] = name

    def read(path):
        try:
            return path.read_text(errors="replace")
        except OSError:
            return ""

    for m in re.finditer(r"^\s*(token_id|token_secret)\s*=\s*(.+)$", read(HOME / ".modal.toml"), re.M):
        add(f"Modal {m.group(1)}", m.group(2))
    for m in re.finditer(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.+)$", read(HOME / ".secrets"), re.M):
        add(f"~/.secrets {m.group(1)}", m.group(2))
    for p in [HOME / ".cache/huggingface/token", HOME / ".huggingface/token"]:
        add("Hugging Face token", read(p))
    for m in re.finditer(r"oauth_token:\s*(\S+)", read(HOME / ".config/gh/hosts.yml")):
        add("GitHub token (gh)", m.group(1))
    for m in re.finditer(r"https?://[^:/\s]+:([^@\s]+)@", read(HOME / ".git-credentials")):
        add("GitHub token (git credential store)", m.group(1))
    town = HOME / ".local/share/porch-delve"
    add("town app password", read(town / "app-password"))
    try:
        for k, v in json.loads(read(town / "session.json") or "{}").items():
            if k.endswith("Jwt"):
                add(f"town session {k}", v)
    except ValueError:
        pass
    for k, v in os.environ.items():
        if re.search(r"KEY|TOKEN|SECRET|PASSWORD|PASSWD", k) and not k.endswith(("_FILE", "_PATH", "_DIR")):
            add(f"environment {k}", v)
    return found


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, check=True).stdout


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "--staged"
    if mode == "--staged":
        text, leaks_cmd, what = git("diff", "--cached", "--no-color", "-U0", "--binary"), ["protect", "--staged"], "staged changes"
    elif mode == "--range":
        rng = sys.argv[2]
        text, leaks_cmd, what = git("log", "-p", "--no-color", "-U0", "--binary", rng), ["detect", f"--log-opts={rng}"], f"commits {rng}"
    elif mode == "--all":
        text, leaks_cmd, what = git("log", "-p", "--no-color", "-U0", "--binary", "--all"), ["detect", "--log-opts=--all"], "the whole history"
    else:
        raise SystemExit(__doc__)
    bad = []
    secrets = known_secrets()
    current = "?"
    for line in text.split(b"\n"):
        if line.startswith(b"+++ b/"):
            current = line[6:].decode(errors="replace")
        elif line.startswith(b"commit "):
            current = line.decode(errors="replace")
        for value, name in secrets.items():
            if value.encode() in line:
                bad.append(f"{name}  in  {current}")
    if shutil.which("gitleaks"):
        r = subprocess.run(["gitleaks", *leaks_cmd, "--source", ".", "--no-banner", "--redact"], capture_output=True, text=True)
        if r.returncode != 0:
            bad.append("gitleaks: " + " | ".join(l for l in (r.stdout + r.stderr).splitlines() if re.search(r"Finding|RuleID|File|leaks found", l))[:600])
    if bad:
        print(f"check-secrets: STOPPED. A secret is in {what} (this repository is public):", file=sys.stderr)
        for b in sorted(set(bad)):
            print("  " + b, file=sys.stderr)
        print("Take it out, and if it was ever pushed, revoke it: deleting the commit is not enough.", file=sys.stderr)
        sys.exit(1)
    print(f"check-secrets: {what} clean ({len(secrets)} local secret values checked" + (", gitleaks ran" if shutil.which("gitleaks") else ", gitleaks not installed") + ")", file=sys.stderr)


if __name__ == "__main__":
    main()
